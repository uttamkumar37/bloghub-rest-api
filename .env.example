# ─── Database ────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=bloghub_db
MYSQL_USER=bloghub_user
MYSQL_PASSWORD=bloghub_pass

# ─── JWT ─────────────────────────────────────────────────────────────────────
# REQUIRED: replace with a 64-char+ random/base64 secret before deploying
# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_use_a_long_random_secret_at_least_64_characters_long
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Security / Bootstrap ────────────────────────────────────────────────────
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_EMAIL=admin@bloghub.local
APP_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost,http://localhost:5173

# ─── Uploads / MinIO Local Dev ───────────────────────────────────────────────
UPLOAD_LOCAL_DIR=/app/uploads
UPLOAD_PUBLIC_BASE_URL=/uploads
UPLOAD_MAX_SIZE_BYTES=5242880
MINIO_ROOT_USER=bloghub_minio
MINIO_ROOT_PASSWORD=bloghub_minio_password

# ─── Observability ───────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
