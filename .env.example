# ─── Database ────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=bloghub_db
MYSQL_USER=bloghub_user
MYSQL_PASSWORD=bloghub_pass

# ─── JWT ─────────────────────────────────────────────────────────────────────
# REQUIRED: replace with a 64-char+ random secret before deploying
# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_use_a_long_random_secret_at_least_64_characters_long_for_HS512
JWT_EXPIRATION_MS=86400000   # 24 hours in milliseconds
